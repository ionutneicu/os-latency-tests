{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug os-latency-tests: one quick benchmark",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/os-latency-tests",
      "args": ["-t", "alloc.malloc_free", "-n", "1000", "--yes"],
      "cwd": "${workspaceFolder}/build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
